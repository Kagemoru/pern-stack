# server config
PORT=3000
NODE_ENV=development

# secrets
JWT_SECRET=random_value
RESET_TOKEN_SECRET=your-long-random-secret

# db config
# option1: by parameter connection 
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=pern_db # your local db name
DB_PASSWORD=120603 # your local user password
# option2: by url connection 
DB_URL=postgresql://postgres:120603@localhost:5432/pern_db

# nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_length_gmail_password
SMTP_FROM=your@gmail.com

# frontend origin
CLIENT_ORIGIN=http://localhost:5173