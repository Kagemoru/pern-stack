# server port
PORT=3000

# secrets
JWT_SECRET=random_value
RESET_TOKEN_SECRET=your-long-random-secret

# db config
# option1: by parameter connection 
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=pern_db_sample
DB_PASSWORD=pern_db_sample_password
# option2: by url connection 
DB_URL=postgresql://postgres:pern_db_sample_password@localhost:5432/pern_db_sample

# nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_length_gmail_password
SMTP_FROM=your@gmail.com